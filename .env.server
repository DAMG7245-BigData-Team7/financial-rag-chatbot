# ============================================
# AURELIA - Server Deployment Configuration
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# OpenAI Configuration (REQUIRED)
# ============================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================
# Pinecone Configuration (REQUIRED)
# ============================================
# Get your API key from: https://app.pinecone.io/
PINECONE_API_KEY=your-pinecone-api-key-here

# Pinecone index name (default: fintbx-hybrid-3072)
# Make sure this index exists in your Pinecone account
PINECONE_INDEX_NAME=fintbx-hybrid-3072

# ============================================
# PostgreSQL Configuration (OPTIONAL)
# ============================================
# Leave as default for the included PostgreSQL container
# Only change if using external PostgreSQL database

# Password for PostgreSQL database
# Change this to a strong password in production!
POSTGRES_PASSWORD=changeme123

# ============================================
# Notes:
# ============================================
# 1. The backend will be available at: http://your-server-ip:8080
# 2. The frontend will be available at: http://your-server-ip:8501
# 3. PostgreSQL port 5432 is exposed if you need direct access
# 4. All services are in the same Docker network for internal communication
# 5. Data is persisted in Docker volumes
